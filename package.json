{
  "name": "dcode",
  "version": "1.0.0",
  "description": "DCODE — 通过供应商 API Key 提供服务的 AI CLI 助手（制作人：Moriarty_Dox）",
  "type": "module",
  "bin": {
    "dcode": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "trace:analyze": "node scripts/trace-analyze.mjs",
    "package": "node scripts/package-release.mjs",
    "start": "node dist/cli.js",
    "prepublishOnly": "node build.mjs"
  },
  "keywords": [
    "deepseek",
    "ai",
    "cli",
    "coding-agent",
    "terminal",
    "assistant",
    "dcode"
  ],
  "author": "Moriarty_Dox",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nikola1ce/DCODE.git"
  },
  "homepage": "https://github.com/Nikola1ce/DCODE#readme",
  "bugs": {
    "url": "https://github.com/Nikola1ce/DCODE/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-glob": "^3.3.2",
    "https-proxy-agent": "^9.1.0",
    "ignore": "^5.3.2",
    "ink": "^5.1.0",
    "openai": "^4.104.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.12",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
